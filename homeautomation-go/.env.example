HA_URL=wss://home-assistant.featherback-mermaid.ts.net/api/websocket
HA_TOKEN=your_token_here
READ_ONLY=false

# Optional: HTTP API server port
# Default: 8080
# HTTP_PORT=8080

# Optional: Override config directory path
# Default: Auto-detects ./configs (container) or ../configs (local dev)
# CONFIG_DIR=./configs

# Optional: Location coordinates for sun event calculations
# Default: Austin, TX area (32.85486, -97.50515)
# LATITUDE=32.85486
# LONGITUDE=-97.50515

# Optional: Timezone for time-based automations (e.g., free energy windows)
# Default: UTC
# Examples: America/New_York, America/Chicago, America/Los_Angeles, Europe/London
# See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# TIMEZONE=America/New_York

# Optional: ntfy.sh topic URL for push notifications
# If not set, notifications will be disabled (logged as error at startup)
# Format: https://ntfy.sh/your-topic-id (or self-hosted instance URL)
# NTFY_TOPIC_URL=https://ntfy.sh/your-secret-topic

# Optional: SoCo-CLI HTTP API URL for Tidal playlist support
# If not set, Tidal playlists in music_config.yaml will not work
# SOCO_CLI_URL=http://127.0.0.1:8000

# Required (production): Base URL Sonos speakers fetch synthesized announcements from.
# This must be a LAN address reachable by the Sonos hardware on the local network
# (Sonos cannot reach Tailscale-served URLs). Typically the LAN IP of the host
# running this service plus the TTS_SERVE_PORT below.
# Example: http://10.212.100.100:8085
# TTS_SERVE_URL=http://10.212.100.100:8085

# Optional: Port the local TTS audio file server listens on.
# Default: 8085
# TTS_SERVE_PORT=8085

# Optional: Kokoro TTS endpoint (OpenAI-compatible /audio/speech)
# Default: https://llms-mac-studio.featherback-mermaid.ts.net/v1/audio/speech
# TTS_ENDPOINT=https://llms-mac-studio.featherback-mermaid.ts.net/v1/audio/speech

# Optional: Kokoro voice id (e.g. af_heart, bf_emma, ...)
# Default: af_heart
# TTS_VOICE=af_heart

# --- Tesla Fleet API (optional) ----------------------------------------------
# Leave TESLA_CLIENT_ID empty to keep the Tesla plugin idle.
# Setup is documented in the host-config-as-code repository at
# services/applications/tesla-key/SETUP.md
#
# From the app you create at https://developer.tesla.com/
# TESLA_CLIENT_ID=
# TESLA_CLIENT_SECRET=
#
# The domain registered with Tesla. It must publicly serve the EC public key at
# /.well-known/appspecific/com.tesla.3p.public-key.pem, and it must be a domain you
# own — a .ts.net name registers successfully but will not pair a virtual key.
# TESLA_DOMAIN=tesla-key.nickborgers.net
#
# Must match the redirect URI registered with Tesla exactly. Only a browser loads it,
# reached through an SSH tunnel while authorizing:
#   ssh -L 8081:localhost:8081 dockergeneric
# A tailnet hostname does not work here — Tesla rejects a redirect host that does not
# resolve in public DNS.
# TESLA_REDIRECT_URI=http://localhost:8081/api/tesla/callback
#
# EC private key that signs vehicle commands, and the file holding the OAuth
# tokens. The token file must be writable: Tesla rotates the refresh token.
# TESLA_PRIVATE_KEY=/app/tesla/private-key.pem
# TESLA_TOKEN_STORE=/app/state/tesla-tokens.json
#
# Which car to manage. When this is empty the plugin manages the only car on the
# account. With more than one car on the account, set it — otherwise the plugin
# picks whichever one Tesla lists first, which can change between calls.
# TESLA_VIN=
#
# Poll interval in minutes. The default is 5; this deployment uses 60. Tesla bills
# per request, so this is a recurring cost, not a free read. Only the car is
# polled; Powerwall data is meant to come from the gateways on the LAN, which is
# free.
# TESLA_POLL_MINUTES=60
#
# Powerwall support needs the energy_cmds scope, which is requested at login.
# Scopes are fixed when a token is issued, so a deployment authorized before
# energy support was added must re-run /api/tesla/login to pick it up.
#
# Look up your site ids (one billed request):
#   curl -s http://localhost:8081/api/tesla/energy/sites
#
# Nothing changes a reserve over HTTP. That is a capability for an automation
# to use, and READ_ONLY=true refuses it.
