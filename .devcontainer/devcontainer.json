{
  "name": "Home Automation Go",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": "false"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "bierner.markdown-mermaid"
      ]
    }
  },
  "onCreateCommand": "bash .devcontainer/setup-user.sh \"${localEnv:USER}\"",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/fix-dns-order.sh && bash .devcontainer/refresh-credentials.sh && sudo chown -R \"$(id -u):$(id -g)\" /workspaces 2>/dev/null || true",
  "forwardPorts": [],
  "portsAttributes": {},
  "mounts": [],
  "initializeCommand": "bash .devcontainer/init-host-credentials.sh",
  "remoteEnv": {
    "SSH_AUTH_SOCK": ""
  },
  "updateRemoteUserUID": true,
  "remoteUser": "vscode"
}
