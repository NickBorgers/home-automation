---
# yamllint configuration for home-automation config files.
# Pins linting rules explicitly to avoid version-drift between local
# devcontainer (apt yamllint) and CI Docker (ubuntu:jammy yamllint).

extends: default

rules:
  # Allow on/off values used in hue_config.yaml for light states.
  # check-keys: false prevents false positives on mapping keys like "on:".
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no', 'on', 'off']
    check-keys: false

  # Match Go project's 120-char line limit.
  line-length:
    max: 120

  # Not all config files start with '---'.
  document-start: disable
