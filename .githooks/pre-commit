#!/bin/bash
#
# Git pre-commit hook
# This hook runs automated checks before allowing a commit to proceed.
# It executes the same tests that CI/CD will run to catch issues early.
#
# CACHING: This hook uses test-cache.sh to skip checks if no code has
# changed since the last successful run. To force re-run:
#   .githooks/test-cache.sh --clear-one pre-commit
#
# Installation: This hook is automatically installed by the devcontainer
# postCreateCommand. To manually install, run:
#   chmod +x .githooks/pre-commit
#   ln -sf ../../.githooks/pre-commit .git/hooks/pre-commit
#

set -e  # Exit on any error

echo "🚀 Running pre-commit hook..."
echo "════════════════════════════════════════════════════════════════════════════"

# Change to repository root
cd "$(git rev-parse --show-toplevel)"

# Run pre-commit checks with caching
if .githooks/test-cache.sh pre-commit pre-commit; then
    echo ""
    echo "════════════════════════════════════════════════════════════════════════════"
    echo "✅ Pre-commit hook passed! Proceeding with commit..."
    exit 0
else
    echo ""
    echo "════════════════════════════════════════════════════════════════════════════"
    echo "❌ Pre-commit hook failed!"
    echo ""
    echo "Your commit has been blocked because the checks failed."
    echo "Please fix the issues above and try committing again."
    echo ""
    echo "To skip this hook (NOT recommended), use: git commit --no-verify"
    echo "════════════════════════════════════════════════════════════════════════════"
    exit 1
fi
