#!/bin/bash
#
# Git pre-push hook
# This hook runs automated test validation before allowing a push.
# It executes the same tests that CI/CD will run to catch issues early.
#
# PATH-BASED FILTERING: .githooks/classify-changes.sh sorts the changed files
# into three tiers:
#   docs    only documentation changed -> diagram validation only
#   scoped  only configs that no integration test reads from disk changed
#           -> yamllint, diagrams, and unit tests of the packages that read them
#   full    anything else (and any doubt) -> unit + integration + coverage
# CI uses the same script, so the hook and CI cannot disagree.
#
# CACHING: The unit-tests and integration-tests Makefile targets use
# test-cache.sh to skip tests if no code has changed since the last
# successful run. To force re-run: make cache-clear
#
# Installation: This hook is automatically installed by the devcontainer
# postCreateCommand. To manually install, run:
#   chmod +x .githooks/pre-push
#   ln -sf ../../.githooks/pre-push .git/hooks/pre-push
#

set -e  # Exit on any error

echo ""
echo "🚀 Running pre-push validation..."
echo "════════════════════════════════════════════════════════════════════════════"
echo ""

# Change to repository root
cd "$(git rev-parse --show-toplevel)"

# ──────────────────────────────────────────────────────────────────────
# Path-based filtering: classify the changed files (docs / scoped / full)
# ──────────────────────────────────────────────────────────────────────

# Collect the changed files of every pushed ref. If anything cannot be
# determined, fall back to the full suite.
# Read push info from stdin (format: local_ref local_sha remote_ref remote_sha)
zero="0000000000000000000000000000000000000000"
changed_files=""
undetermined=false
while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip delete pushes
    if [ "$local_sha" = "$zero" ]; then
        continue
    fi

    # For new branches, compare against the default branch (main/master)
    if [ "$remote_sha" = "$zero" ]; then
        base_ref="origin/main"
        if ! git rev-parse --verify "$base_ref" >/dev/null 2>&1; then
            base_ref="origin/master"
        fi
        if ! git rev-parse --verify "$base_ref" >/dev/null 2>&1; then
            undetermined=true
            break
        fi
        # Use the merge base so commits that main gained since branching do not count as changes
        remote_sha=$(git merge-base "$base_ref" "$local_sha" 2>/dev/null) || {
            undetermined=true
            break
        }
    fi

    # If diff fails (e.g., shallow clone, missing objects), run full suite to be safe
    ref_files=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null) || {
        undetermined=true
        break
    }
    changed_files="$changed_files
$ref_files"
done

tier=full
packages=""
if [ "$undetermined" = false ]; then
    classification=$(printf '%s\n' "$changed_files" | .githooks/classify-changes.sh) || classification=""
    tier=$(printf '%s\n' "$classification" | sed -n 's/^tier=//p')
    packages=$(printf '%s\n' "$classification" | sed -n 's/^packages=//p')
    case "$tier" in
        docs | scoped | full) ;;
        *) tier=full ;;
    esac
fi

# ──────────────────────────────────────────────────────────────────────
# Run appropriate validation based on change type
# ──────────────────────────────────────────────────────────────────────

if [ "$tier" = scoped ]; then
    echo ""
    echo "⚙️  Config-only changes detected. Running scoped validation."
    echo "   Unit tests: $packages"
    echo "   Skipping the full unit and integration suites."
    echo ""

    if make pre-push-scoped PKGS="$packages"; then
        echo ""
        echo "✅ Pre-push hook passed (scoped)! Proceeding with push..."
        exit 0
    else
        echo ""
        echo "❌ Pre-push hook failed (scoped). Fix the issues above and try again."
        exit 1
    fi
fi

if [ "$tier" = docs ]; then
    echo ""
    echo "📝 Documentation-only changes detected. Skipping tests."
    echo "   Running diagram validation only (<30 seconds)."
    echo ""

    if make pre-push-docs-only; then
        echo ""
        echo "✅ Pre-push hook passed (docs-only)! Proceeding with push..."
        exit 0
    else
        echo ""
        echo "════════════════════════════════════════════════════════════════════════════"
        echo "❌ Pre-push hook failed!"
        echo ""
        echo "Diagram validation failed. Please fix the issues above and try again."
        echo "════════════════════════════════════════════════════════════════════════════"
        exit 1
    fi
fi

# Full validation for code changes
echo ""
echo "🔧 Code changes detected. Running full validation suite."
echo ""

if make pre-push; then
    echo ""
    echo "✅ Pre-push hook passed! Proceeding with push..."
    exit 0
else
    echo ""
    echo "════════════════════════════════════════════════════════════════════════════"
    echo "❌ Pre-push validation failed!"
    echo ""
    echo "Your push has been blocked because validation failed."
    echo "The pre-push hook runs the same checks as CI:"
    echo "  - Config validation (yamllint)"
    echo "  - Diagram validation"
    echo "  - Build check (go build ./...)"
    echo "  - All tests with race detector (go test -race ./...)"
    echo "  - Code coverage check (≥65%)"
    echo ""
    echo "To fix: Address the failures above and commit the fixes."
    echo "Emergency bypass (NOT recommended): git push --no-verify"
    echo ""
    echo "⚠️  WARNING: Bypassing hooks may push broken code to main."
    echo "════════════════════════════════════════════════════════════════════════════"
    exit 1
fi
